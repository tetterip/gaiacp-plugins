<script>
const search = document.getElementById('search'), cards = [...document.querySelectorAll('.card')], empty = document.getElementById('empty');
search.addEventListener('input', () => {
    const words = search.value.toLowerCase().split(/\s+/).filter(Boolean);
    let shown = 0;
    cards.forEach(card => { const hit = words.every(word => card.dataset.search.includes(word)); card.hidden = !hit; shown += hit; });
    empty.style.display = shown ? 'none' : 'block';
});
</script>
